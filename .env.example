# Server-side environment variables for Field Shift
# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored and must never be committed.

# Google AI Studio API key (server-side only, never sent to the client).
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the default model (gemini-3.5-flash-lite).
# GEMINI_MODEL=gemini-3.5-flash-lite

# Meteomatics Weather API credentials (server-side only, supplementary forecast).
# NASA POWER remains the core climatology source.
METEOMATICS_USER=
METEOMATICS_PASS=
